# ── Database ────────────────────────────────────────────────────────────────
# packages/db reads this. Local dev matches the docker-compose service below.
DATABASE_URL="postgresql://gurukulam:gurukulam@localhost:5432/gurukulam_dev?schema=public"

# ── API (apps/api) ──────────────────────────────────────────────────────────
API_PORT=4000
API_BASE_PATH=/api/v1
JWT_ACCESS_SECRET="change-me-in-every-environment"
JWT_REFRESH_SECRET="change-me-too-and-never-reuse-the-access-secret"
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
REDIS_URL="redis://localhost:6379"
CORS_ALLOWED_ORIGINS="http://localhost:3000"
CRON_SHARED_SECRET="change-me"

# ── Who issues a receipt ────────────────────────────────────────────────────
# Printed on every payment receipt. Only the name is required; a field left
# blank is simply omitted from the document, which is better than a receipt
# carrying a placeholder GSTIN somebody then files.
ORG_LEGAL_NAME="Gurukulam"
ORG_ADDRESS=""
ORG_GSTIN=""
ORG_EMAIL=""
ORG_PHONE=""

# ── Web (apps/web) ──────────────────────────────────────────────────────────
# Server-side only. The browser never talks to the API directly — apps/web is a BFF.
API_INTERNAL_URL="http://localhost:4000/api/v1"
