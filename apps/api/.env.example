NODE_ENV=development
API_PORT=4000
API_BASE_PATH=/api/v1

# The interface to bind. Loopback by default: the console is a BFF and talks to
# the API over loopback, so nothing else needs to reach it. Set 0.0.0.0 only for
# a genuine direct consumer, and then front it with a proxy and set TRUST_PROXY.
API_HOST=127.0.0.1

# Whose X-Forwarded-For to believe. `false` means nobody, and `req.ip` is then
# the socket peer, which cannot be forged. Behind nginx on the same host, name
# the proxy: TRUST_PROXY=127.0.0.1
#
# Do NOT set `true` — it makes the client address whatever the caller writes in
# the header, and the per-caller rate limit on login stops meaning anything.
# A bare hop count is refused: fastify 5.12.3 made `trustProxy: <number>` trust
# nobody, so it would look configured and do nothing.
TRUST_PROXY=false

# The generated OpenAPI document and its Swagger page. They bypass the auth
# guard, so they are a complete map of the API to anyone who can reach the port.
# Unset means: on outside production, off in it.
# API_DOCS_ENABLED=false

DATABASE_URL="postgresql://gurukulam:gurukulam@localhost:5432/gurukulam_dev?schema=public"

# openssl rand -base64 48 — twice, and never reuse one for the other.
JWT_ACCESS_SECRET="change-me-in-every-environment"
JWT_REFRESH_SECRET="change-me-too-and-never-reuse-the-access-secret"
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Without it, login lockout and rate limiting are per-process and bounded in
# memory. Fine for one dev instance; not for anything with replicas.
REDIS_URL="redis://localhost:6379"

# Only matters for direct API consumers. The console never calls the API from
# the browser, so it needs no entry here.
CORS_ALLOWED_ORIGINS="http://localhost:3000"
