{
  "name": "gurukulam",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.33.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:migrate": "pnpm --filter @gurukulam/db migrate",
    "db:generate": "pnpm --filter @gurukulam/db generate",
    "db:seed": "pnpm --filter @gurukulam/db seed",
    "db:reset": "pnpm --filter @gurukulam/db reset",
    "db:studio": "pnpm --filter @gurukulam/db studio"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
